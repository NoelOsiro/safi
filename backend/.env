############################################################
# Local environment variables for safi backend
# Copy this file to .env and fill secrets before running.
############################################################

# LangSmith / LangChain tracing (used by `langsmith.traceable`)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=EchoVoice-Graph

# ------------------- Model / Hosting ----------------------
# API backend selection: one of: github | azure | ollama | openai
API_HOST=github

# GitHub Models (models.inference.ai) credentials
GITHUB_TOKEN=your_github_models_token_here
GITHUB_MODEL=gpt-4o

# OpenAI (fallback)
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (if using Azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Ollama (local LLM) endpoint / model
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_SAFETY_MODEL=llama3.1

# General model temperature for generation (float)
GENERATION_TEMPERATURE=0.2

# Lightweight safety classifier model name (can be small)
SAFETY_MODEL=gpt-4o-mini

# ------------------- Retriever / Embeddings ----------------
# Which backend to use for retrieval: tfidf | faiss | github_models | auto
RETRIEVER_BACKEND=tfidf

# Path to corpus used by retriever (relative to repo root)
RETRIEVER_DATA_PATH=./data/sample_docs.json

# Optional persistent index path prefix (for FAISS / saved indexes)
RETRIEVER_INDEX_PATH=./data/index

# Embedding model (for GitHub Models or external embeddings)
EMBED_MODEL=all-MiniLM-L6-v2

# Embedding API retry/timeout settings
EMBEDDING_API_TIMEOUT=30
EMBEDDING_API_MAX_RETRIES=3
EMBEDDING_API_BACKOFF=1.5

# Hybrid prefilter: use TF-IDF to prefilter candidates before vector search
HYBRID_PREFILTER_TOPK=0

# FAISS index tuning (only used if FAISS backend enabled)
FAISS_INDEX_TYPE=flat
FAISS_NLIST=100
FAISS_HNSW_M=32
FAISS_HNSW_EF_CONSTRUCTION=200

# Retriever logging level
RETRIEVER_LOG_LEVEL=INFO

# ------------------- Segmentation / Rules ------------------
# Semantic segmentation config
SEGMENTER_VERSION=1.1
SEGMENTER_PRODUCT_PATHS=shoes,accessories,apparel
SEGMENTER_KEYWORDS=refund,return,shipping,billing,payment

# ------------------- Observability / Misc ------------------
# Allow toggling debug / local testing behavior
DEBUG=false

############################################################
